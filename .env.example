# Copy to .env for local development. Never commit the real .env.

# Required
MONGO_URI=
# Required on Vercel; signs the session cookie.
SECRET_KEY=

# File uploads (team photos, sponsor logos, STL models)
BLOB_READ_WRITE_TOKEN=

# Base URL used in password-reset links, e.g. https://mephamrobotics.example
PUBLIC_BASE_URL=

# RobotEvents v2 API token. Enables live match results on /achievements and the
# live skills, season numbers and event results on team pages (api/robotevents.py).
# The older name ROBOTEVENTS_TOKEN is still read if this one is unset.
ROBOTEVENTS_API_KEY=

# On-site assistant
CHATBOT_API_KEY=
CHATBOT_API_URL=
CHATBOT_MODEL=

# Donation embed on /donate; without it the page shows an email fallback
GIVEBUTTER_CAMPAIGN_ID=
CONTACT_EMAIL=

# Outgoing email through Resend (resend.com): self-service password resets,
# new-message and sign-up alerts to admins, and "account approved" notes.
# MAIL_FROM must use a domain verified in Resend, e.g. Mepham Robotics <club@yourdomain>.
# Without both, nothing is sent and the login page says to ask an admin.
RESEND_API_KEY=
MAIL_FROM=

# Time zone that event times are entered in (default America/New_York)
CLUB_TIMEZONE=

# Set to 1 to enable the Werkzeug debugger for `python api/index.py`
FLASK_DEBUG=
